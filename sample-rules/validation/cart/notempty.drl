package com.company.rules.validation.cart

import java.util.Map
import java.util.List

// `not` pattern: fires when a pattern is ABSENT from working memory. Here we check that
// no Map exists with a non-empty `items` list — equivalent to "the cart is missing the
// items field, OR items is null, OR items is an empty list".
//
// Since the project's stateless one-shot architecture inserts a single Map ($data),
// `not Map(...)` checks $data itself: the not-pattern fires iff $data does not match.
rule "Reject Empty Cart"
when
    $data : Map()
    not Map( this["items"] != null,
             ((List) this["items"]).size() > 0 )
then
    $data.put("validationResult", "REJECTED");
    $data.put("reason", "EMPTY_CART");
    $data.put("validationMethod", "not-pattern");
end
