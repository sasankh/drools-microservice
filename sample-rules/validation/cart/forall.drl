package com.company.rules.validation.cart

import java.util.Map
import java.util.List

// `forall` pattern: universal quantification — fires when every fact matching the base
// pattern also matches the additional pattern(s). Reads as "for every X, X must satisfy Y".
//
// Here we iterate the cart's `items` list twice: once binding $item, then re-deriving the
// same item via `this == $item` to assert its stockLevel > 0. The forall is satisfied iff
// every item in the list has stockLevel > 0.
//
// Functional equivalent: `not Map(((Number)this["stockLevel"]).intValue() <= 0) from items`.
// We use the explicit `forall` keyword here to demonstrate the cookbook pattern; the
// `not` form is shown in validation/cart/notempty.drl.
rule "All Cart Items In Stock"
when
    $data : Map(this["items"] != null)
    forall (
        $item : Map() from ((List) $data.get("items"))
        Map( this == $item, ((Number) this["stockLevel"]).intValue() > 0 )
            from ((List) $data.get("items"))
    )
then
    $data.put("allItemsInStock", true);
    $data.put("validationMethod", "forall");
end
