package com.company.rules.pricing.loyalty

import java.util.Map

// Salience pattern: when multiple rules' LHSes match the same fact, Drools fires them in
// salience order (higher first). This rule has salience 100, so it fires before any rule
// with the default salience of 0. Useful for "always-applies" overrides like loyalty pricing.
//
// Note: with input that also matches pricing.discount.simple (amount > 50), both rules will
// fire — loyalty first because of the higher salience. The cookbook entry documents the
// stacking effect.
rule "Loyalty Member Discount"
salience 100
when
    $data : Map(this["loyaltyMember"] == true,
                this["amount"] != null)
then
    double amount = ((Number) $data.get("amount")).doubleValue();
    double discount = amount * 0.15;
    $data.put("amount", amount - discount);
    $data.put("loyaltyDiscount", discount);
    $data.put("loyaltyApplied", true);
    $data.put("discountReason", "Loyalty member - 15% off (salience 100)");
end
