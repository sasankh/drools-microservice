package com.company.rules.pricing.loyalty

import java.util.Map

// Salience pattern: when several rules in the SAME DRL file match the same fact, Drools fires
// them in salience order (higher first). This rule has salience 100, so it would fire before
// any default-salience (0) rule added to this file. Rules in other rule_ids never fire on a
// request for pricing.loyalty.salience (each rule_id is isolated — ADR-025).
rule "Loyalty Member Discount"
salience 100
when
    $data : Map(this["loyaltyMember"] == true,
                this["amount"] != null)
then
    double amount = ((Number) $data.get("amount")).doubleValue();
    double discount = amount * 0.15;
    $data.put("amount", amount - discount);
    $data.put("loyaltyDiscount", discount);
    $data.put("loyaltyApplied", true);
    $data.put("discountReason", "Loyalty member - 15% off (salience 100)");
end
