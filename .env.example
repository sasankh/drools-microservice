# Drools Rule Engine Microservice - Environment Configuration
# Copy this file to .env and modify values as needed

# ====================================================================
# RULE STORAGE CONFIGURATION
# ====================================================================

# Storage backend: memory, local, s3
RULE_SOURCE=s3

# S3 Configuration (when RULE_SOURCE=s3)
RULE_BUCKET_NAME=local-rules
AWS_REGION=us-east-1

# LocalStack Configuration (for local development)
# Comment out for production AWS S3
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Production AWS S3 Configuration
# Uncomment and set for production
# AWS_ACCESS_KEY_ID=your-production-access-key
# AWS_SECRET_ACCESS_KEY=your-production-secret-key

# Local File Storage Configuration (when RULE_SOURCE=local)
# RULE_BASE_PATH=/path/to/rules

# ====================================================================
# CACHING CONFIGURATION
# ====================================================================

# Redis Distributed Cache (optional). When enabled, RedisCachedRuleStorage
# wraps the base storage and other ECS tasks receive pub/sub refresh events.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# DRL rule cache (active when REDIS_ENABLED=true)
REDIS_DRL_RULES_TTL_MINUTES=15
REDIS_DRL_RULES_KEY_PREFIX=drools:rule:

# Pub/Sub fan-out for multi-task refresh convergence
REDIS_PUBSUB_ENABLED=true
REDIS_REFRESH_CHANNEL=drools:rule:events

# Lettuce command timeout. 500ms default sits below the Redis CB's slowCallDurationThreshold (2s)
# so command timeouts unambiguously count as failures (not slow calls), letting the CB engage
# cleanly during Redis outages. Raise to 1000–1500ms for distant or high-latency Redis.
REDIS_TIMEOUT=500ms

# Redis with authentication
# REDIS_URL=redis://username:password@localhost:6379

# Redis cluster configuration
# REDIS_URL=redis://node1:6379,redis://node2:6379

# Redis SSL configuration
# REDIS_URL=rediss://ssl-redis-host:6380

# ====================================================================
# PERFORMANCE CONFIGURATION
# ====================================================================

# Rule execution timeout (seconds)
RULE_EXECUTION_TIMEOUT_SECONDS=30

# Thread pool configuration
# RULE_EXECUTOR_THREAD_POOL_SIZE=10
# RULE_EXECUTOR_QUEUE_CAPACITY=100

# JVM memory settings (for docker deployment)
# JAVA_OPTS=-Xmx2g -Xms1g -XX:+UseG1GC

# ====================================================================
# LOGGING CONFIGURATION
# ====================================================================

# Log level: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Specific logger levels
# LOGGER_DROOLS=DEBUG
# LOGGER_CACHE=DEBUG
# LOGGER_STORAGE=DEBUG
# LOGGER_ADMIN=INFO

# JSON logging for production
# LOGGING_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n
# LOGGING_PATTERN_FILE=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n

# ====================================================================
# MONITORING & HEALTH CHECKS
# ====================================================================

# Management endpoints
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# Health check intervals (milliseconds)
# HEALTH_CHECK_INTERVAL_S3=30000
# HEALTH_CHECK_INTERVAL_REDIS=10000
# HEALTH_CHECK_INTERVAL_DROOLS=15000

# ====================================================================
# SECURITY CONFIGURATION (for production)
# ====================================================================

# Admin API security (uncomment for production)
# ADMIN_API_USERNAME=admin
# ADMIN_API_PASSWORD=your-secure-password
# ADMIN_API_ENABLED=true

# API rate limiting
# RATE_LIMIT_REQUESTS_PER_MINUTE=1000
# RATE_LIMIT_ENABLED=false

# CORS configuration
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE
# CORS_ALLOWED_HEADERS=*

# ====================================================================
# DEVELOPMENT CONFIGURATION
# ====================================================================

# Development mode settings
# SPRING_PROFILES_ACTIVE=local
# SPRING_DEVTOOLS_RESTART_ENABLED=true

# Hot reload configuration
# RULE_HOT_RELOAD_ENABLED=true
# RULE_HOT_RELOAD_INTERVAL_SECONDS=60

# Debug configuration
# SPRING_JPA_SHOW_SQL=false
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=INFO
# LOGGING_LEVEL_COM_COMPANY_DROOLS=DEBUG

# ====================================================================
# DATABASE CONFIGURATION (if needed for rule metadata)
# ====================================================================

# H2 Database (for development)
# SPRING_DATASOURCE_URL=jdbc:h2:mem:testdb
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=

# PostgreSQL (for production)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/drools_rules
# SPRING_DATASOURCE_USERNAME=drools_user
# SPRING_DATASOURCE_PASSWORD=your-db-password
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# ====================================================================
# EXTERNAL INTEGRATIONS
# ====================================================================

# CloudWatch metrics (for AWS deployment)
# CLOUDWATCH_NAMESPACE=DroolsRuleEngine
# CLOUDWATCH_ENABLED=false
# CLOUDWATCH_STEP=PT1M

# Prometheus metrics
# MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# External rule validation service
# RULE_VALIDATION_SERVICE_URL=http://validation-service:8080
# RULE_VALIDATION_ENABLED=false

# ====================================================================
# DOCKER CONFIGURATION
# ====================================================================

# Container configuration
# SPRING_PROFILES_ACTIVE=docker
# SERVER_PORT=8080
# MANAGEMENT_SERVER_PORT=8081

# Docker network configuration
# LOCALSTACK_HOSTNAME=localstack
# REDIS_HOSTNAME=redis

# ====================================================================
# KUBERNETES CONFIGURATION
# ====================================================================

# Kubernetes health check configuration
# MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
# MANAGEMENT_HEALTH_LIVENESSSTATE_ENABLED=true
# MANAGEMENT_HEALTH_READINESSSTATE_ENABLED=true

# Pod configuration
# KUBERNETES_NAMESPACE=default
# KUBERNETES_SERVICE_NAME=drools-rule-engine

# ====================================================================
# TESTING CONFIGURATION
# ====================================================================

# Test profiles
# SPRING_PROFILES_ACTIVE=test

# Test storage configuration
# TEST_RULE_SOURCE=memory
# TEST_REDIS_ENABLED=false

# Integration test configuration
# TEST_LOCALSTACK_ENABLED=true
# TEST_S3_BUCKET_NAME=test-rules

# Performance test configuration
# PERF_TEST_CONCURRENT_USERS=50
# PERF_TEST_DURATION_SECONDS=300
# PERF_TEST_RAMP_UP_SECONDS=60

# ====================================================================
# SONARQUBE MCP (.mcp.json — Claude Code)
# ====================================================================
# Required by .mcp.json (committed) for the SonarQube MCP server.
# Set these in your shell rc (~/.zshrc / ~/.bashrc) — NEVER commit real values.
#
# How to get a SonarQube user token:
#   SonarQube UI → My Account → Security → Generate Tokens (type: User Token)
#
# Verify after setting:
#   echo "$SONARQUBE_TOKEN"   # should print your token
#   curl -s "$SONARQUBE_URL/api/system/status" | jq   # expect "status":"UP"

SONARQUBE_TOKEN=<your-sonarqube-user-token>

# Use http://localhost:9000 if SonarQube runs on your host AND the MCP container
# can reach it. On macOS, containers reach the host via host.docker.internal,
# so use http://host.docker.internal:9000 instead.
SONARQUBE_URL=http://localhost:9000